@model web_tcg.Models.Admin.CreateCountryViewModel

@{
    ViewData["Title"] = "Créer un pays";
    Layout = "_Layout";
}

<link rel="stylesheet"
      href="~/css/admin-country-create.css"
      asp-append-version="true" />

<div class="admin-create-country-page">

    <!-- BACKGROUND -->
    <div class="admin-create-country-background">
        <div class="admin-create-country-grid"></div>

        <div class="admin-create-country-glow admin-create-country-glow-1"></div>
        <div class="admin-create-country-glow admin-create-country-glow-2"></div>
    </div>

    <div class="admin-create-country-container">

        <!-- HEADER -->
        <header class="admin-create-country-header">

            <div class="admin-create-country-breadcrumb-row">

                <a asp-controller="Admin"
                   asp-action="Countries"
                   class="admin-create-country-back">
                    <i data-lucide="arrow-left"></i>
                    <span>Pays</span>
                </a>

                <i data-lucide="chevron-right"
                   class="admin-create-country-breadcrumb-icon"></i>

                <span class="admin-create-country-breadcrumb-current">
                    NOUVEAU PAYS
                </span>

            </div>

            <div class="admin-create-country-title">

                <div class="admin-create-country-title-icon">
                    <i data-lucide="globe-2"></i>
                </div>

                <div>

                    <div class="admin-create-country-eyebrow">
                        ADMINISTRATION
                    </div>

                    <h1>
                        Créer un
                        <span>Pays</span>
                    </h1>

                    <p>
                        Ajoutez un pays et associez-le à une région
                        pour compléter la structure géographique du TCG.
                    </p>

                </div>

            </div>

        </header>


        <!-- VALIDATION -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="admin-create-country-alert">

                <div class="admin-create-country-alert-icon">
                    <i data-lucide="alert-triangle"></i>
                </div>

                <div class="admin-create-country-alert-content">

                    <strong>
                        Vérifiez les informations
                    </strong>

                    <ul>
                        @foreach (var entry in ViewData.ModelState)
                        {
                            foreach (var error in entry.Value.Errors)
                            {
                                if (!string.IsNullOrWhiteSpace(error.ErrorMessage))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            }
                        }
                    </ul>

                </div>

            </div>
        }


        <!-- CONTENT -->
        <form asp-controller="Admin"
              asp-action="CreateCountry"
              method="post"
              class="admin-create-country-layout">

            @Html.AntiForgeryToken()

            <!-- FORM -->
            <div class="admin-create-country-form">

                <!-- SECTION 01 -->
                <section class="admin-create-country-section">

                    <div class="admin-create-country-section-heading">

                        <div class="admin-create-country-section-number">
                            01
                        </div>

                        <div>

                            <span>CONFIGURATION</span>

                            <h2>
                                Informations du pays
                            </h2>

                            <p>
                                Définissez l'identité du pays
                                et son rattachement géographique.
                            </p>

                        </div>

                    </div>


                    <div class="admin-create-country-fields">

                        <!-- NAME -->
                        <div class="admin-create-country-field">

                            <label asp-for="Name">
                                Nom du pays
                                <span>*</span>
                            </label>

                            <div class="admin-create-country-input-wrapper">

                                <i data-lucide="map-pin"></i>

                                <input asp-for="Name"
                                       id="Name"
                                       placeholder="Ex : France"
                                       autocomplete="off" />

                            </div>

                            <span asp-validation-for="Name"
                                  class="admin-create-country-validation">
                            </span>

                            <small>
                                Nom officiel ou nom d'affichage du pays.
                            </small>

                        </div>


                        <!-- CODE -->
                        <div class="admin-create-country-field">

                            <label asp-for="Code">
                                Code
                                <span>*</span>
                            </label>

                            <div class="admin-create-country-input-wrapper">

                                <i data-lucide="hash"></i>

                                <input asp-for="Code"
                                       id="Code"
                                       maxlength="3"
                                       placeholder="Ex : FR"
                                       autocomplete="off" />

                            </div>

                            <span asp-validation-for="Code"
                                  class="admin-create-country-validation">
                            </span>

                            <small>
                                Code court du pays, maximum 3 caractères.
                            </small>

                        </div>


                        <!-- REGION -->
                        <div class="admin-create-country-field field-full">

                            <label asp-for="RegionId">
                                Région / Faction
                                <span>*</span>
                            </label>

                            <div class="admin-create-country-input-wrapper">

                                <i data-lucide="layers-3"></i>

                                <select asp-for="RegionId"
                                        asp-items="ViewBag.Regions"
                                        id="RegionId">

                                    <option value="">
                                        -- Sélectionnez une région --
                                    </option>

                                </select>

                                <i data-lucide="chevron-down"
                                   class="admin-create-country-select-arrow"></i>

                            </div>

                            <span asp-validation-for="RegionId"
                                  class="admin-create-country-validation">
                            </span>

                            <small>
                                Chaque pays doit obligatoirement appartenir
                                à une région.
                            </small>

                        </div>

                    </div>

                </section>


                <!-- SECTION 02 -->
                <section class="admin-create-country-section">

                    <div class="admin-create-country-section-heading">

                        <div class="admin-create-country-section-number">
                            02
                        </div>

                        <div>

                            <span>APERÇU</span>

                            <h2>
                                Identité du pays
                            </h2>

                            <p>
                                Vérifiez rapidement les informations
                                avant de créer le pays.
                            </p>

                        </div>

                    </div>


                    <div class="admin-create-country-preview-card">

                        <div class="admin-create-country-preview-glow"></div>

                        <div class="admin-create-country-preview-main">

                            <div id="regionColor"
                                 class="admin-create-country-region-color"
                                 style="background-color: #6B7280;">

                                <i data-lucide="globe-2"></i>

                            </div>

                            <div class="admin-create-country-preview-info">

                                <span>
                                    PAYS
                                </span>

                                <strong id="countryNamePreview">
                                    Nouveau pays
                                </strong>

                                <small id="countryCodePreview">
                                    ---
                                </small>

                            </div>

                        </div>


                        <div class="admin-create-country-preview-divider"></div>


                        <div class="admin-create-country-preview-meta">

                            <div>

                                <span>
                                    RÉGION
                                </span>

                                <strong id="regionPreview">
                                    Non sélectionnée
                                </strong>

                            </div>

                            <div>

                                <span>
                                    CODE
                                </span>

                                <strong id="regionCodePreview">
                                    ---
                                </strong>

                            </div>

                        </div>

                    </div>

                </section>


                <!-- ACTIONS -->
                <div class="admin-create-country-actions">

                    <a asp-controller="Admin"
                       asp-action="Countries"
                       class="admin-create-country-cancel">

                        <i data-lucide="arrow-left"></i>

                        <span>
                            Annuler
                        </span>

                    </a>


                    <button type="submit"
                            class="admin-create-country-submit">

                        <i data-lucide="plus"></i>

                        <span>
                            Créer le pays
                        </span>

                        <i data-lucide="arrow-up-right"></i>

                    </button>

                </div>

            </div>


            <!-- SIDE PANEL -->
            <aside class="admin-create-country-sidebar">

                <div class="admin-create-country-sidebar-panel">

                    <div class="admin-create-country-sidebar-header">

                        <div>

                            <span>
                                STRUCTURE
                            </span>

                            <h2>
                                Organisation
                            </h2>

                        </div>

                        <div class="admin-create-country-live">
                            <span></span>
                            LIVE
                        </div>

                    </div>


                    <div class="admin-create-country-structure">

                        <div class="admin-create-country-structure-item">

                            <div class="admin-create-country-structure-icon">
                                <i data-lucide="globe-2"></i>
                            </div>

                            <div>

                                <span>
                                    PAYS
                                </span>

                                <strong id="sideCountryName">
                                    Nouveau pays
                                </strong>

                            </div>

                        </div>


                        <div class="admin-create-country-structure-line">
                        </div>


                        <div class="admin-create-country-structure-item">

                            <div class="admin-create-country-structure-icon">
                                <i data-lucide="layers-3"></i>
                            </div>

                            <div>

                                <span>
                                    RÉGION
                                </span>

                                <strong id="sideRegionName">
                                    Non sélectionnée
                                </strong>

                            </div>

                        </div>

                    </div>


                    <div class="admin-create-country-sidebar-info">

                        <div class="admin-create-country-sidebar-info-icon">
                            <i data-lucide="info"></i>
                        </div>

                        <p>
                            La région détermine l'organisation
                            géographique et la couleur associée
                            au pays dans le TCG.
                        </p>

                    </div>

                </div>

            </aside>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function() {

            const nameInput =
                document.getElementById('Name');

            const codeInput =
                document.getElementById('Code');

            const regionInput =
                document.getElementById('RegionId');

            const namePreview =
                document.getElementById('countryNamePreview');

            const codePreview =
                document.getElementById('countryCodePreview');

            const regionPreview =
                document.getElementById('regionPreview');

            const regionCodePreview =
                document.getElementById('regionCodePreview');

            const regionColor =
                document.getElementById('regionColor');

            const sideCountryName =
                document.getElementById('sideCountryName');

            const sideRegionName =
                document.getElementById('sideRegionName');


            function updatePreview() {

                const name =
                    nameInput.value.trim();

                const code =
                    codeInput.value.trim().toUpperCase();

                const selectedOption =
                    regionInput.options[regionInput.selectedIndex];


                namePreview.textContent =
                    name || 'Nouveau pays';

                codePreview.textContent =
                    code || '---';

                sideCountryName.textContent =
                    name || 'Nouveau pays';


                if (
                    selectedOption &&
                    selectedOption.value
                ) {

                    const regionName =
                        selectedOption.textContent.trim();

                    regionPreview.textContent =
                        regionName;

                    sideRegionName.textContent =
                        regionName;

                    /*
                     * Si les options possèdent des attributs
                     * data-color / data-code, ils sont utilisés
                     * automatiquement.
                     */
                    const color =
                        selectedOption.dataset.color;

                    const regionCode =
                        selectedOption.dataset.code;

                    if (color) {
                        regionColor.style.backgroundColor =
                            color;
                    }
                    else {
                        regionColor.style.backgroundColor =
                            '#6B7280';
                    }

                    regionCodePreview.textContent =
                        regionCode || '---';

                }
                else {

                    regionPreview.textContent =
                        'Non sélectionnée';

                    sideRegionName.textContent =
                        'Non sélectionnée';

                    regionCodePreview.textContent =
                        '---';

                    regionColor.style.backgroundColor =
                        '#6B7280';
                }
            }


            nameInput.addEventListener(
                'input',
                updatePreview
            );


            codeInput.addEventListener(
                'input',
                function() {

                    this.value =
                        this.value
                            .toUpperCase()
                            .replace(/[^A-Z0-9]/g, '')
                            .slice(0, 3);

                    updatePreview();
                }
            );


            regionInput.addEventListener(
                'change',
                updatePreview
            );


            updatePreview();


            if (window.lucide) {
                lucide.createIcons();
            }

        });
    </script>
}