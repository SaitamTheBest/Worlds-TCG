@model web_tcg.Models.Admin.CreateCardSetViewModel

@{
var cardSetId = ViewData["CardSetId"] as int?;
var isEditing = cardSetId.HasValue;
ViewData["Title"] = isEditing ? "Modifier une extension" : "Créer une extension";
Layout = "_Layout";
}

<link rel="stylesheet"
      href="~/css/admin-card-set-create.css"
      asp-append-version="true" />

<link rel="stylesheet" href="~/css/card-image-upload.css" asp-append-version="true" />

<div class="admin-create-set-page">


<!-- BACKGROUND -->
<div class="admin-create-set-background">
    <div class="admin-create-set-grid"></div>
    <div class="admin-create-set-glow admin-create-set-glow-1"></div>
    <div class="admin-create-set-glow admin-create-set-glow-2"></div>
</div>

<div class="admin-create-set-container">

    <!-- HEADER -->
    <header class="admin-create-set-header">

        <div>

            <a asp-controller="Admin"
               asp-action="CardSets"
               class="admin-create-set-back">
                <i data-lucide="arrow-left"></i>
                <span>Extensions</span>
            </a>

            <div class="admin-create-set-breadcrumb">
                <span>ADMINISTRATION</span>
                <i data-lucide="chevron-right"></i>
                <span>@(isEditing ? "MODIFIER L’EXTENSION" : "NOUVELLE EXTENSION")</span>
            </div>

            <div class="admin-create-set-title">

                <div class="admin-create-set-title-icon">
                    <i data-lucide="layers-3"></i>
                </div>

                <div>
                    <h1>
                        @(isEditing ? "Modifier une" : "Créer une")
                        <span>Extension</span>
                    </h1>

                    <p>
                        @(isEditing ? "Modifiez les informations de l’extension et son booster." : "Configurez une nouvelle extension et son booster pour l’intégrer au catalogue du TCG.")
                    </p>
                </div>

            </div>

        </div>

    </header>


    <!-- VALIDATION ERRORS -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="admin-create-set-alert">

            <div class="admin-create-set-alert-icon">
                <i data-lucide="alert-triangle"></i>
            </div>

            <div class="admin-create-set-alert-content">

                <strong>
                    @(isEditing ? "Impossible de modifier l’extension" : "Impossible de créer l’extension")
                </strong>

                <ul>
                    @foreach (var entry in ViewData.ModelState)
                    {
                        foreach (var error in entry.Value.Errors)
                        {
                            if (!string.IsNullOrWhiteSpace(error.ErrorMessage))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        }
                    }
                </ul>

            </div>

        </div>
    }


    <!-- FORM -->
    <form asp-controller="Admin"
          asp-action="@(isEditing ? "EditCardSet" : "CreateCardSet")"
          asp-route-id="@cardSetId"
          id="createCardSetForm"
          data-existing-image-path="@ViewData["ExistingBoosterImageUrl"]"
          data-card-image-upload-url="/Admin/CardSets/UploadImage"
          method="post"
          class="admin-create-set-layout">

        @Html.AntiForgeryToken()


        <!-- ==========================================
             LEFT : FORM
             ========================================== -->

        <div class="admin-create-set-form">


            <!-- SECTION 01 -->
            <section class="admin-create-set-section">

                <div class="admin-create-set-section-heading">

                    <div class="admin-create-set-section-number">
                        01
                    </div>

                    <div>
                        <span>CONFIGURATION</span>

                        <h2>
                            Informations de l'extension
                        </h2>

                        <p>
                            Définissez les informations principales
                            de votre extension.
                        </p>
                    </div>

                </div>


                <div class="admin-create-set-fields">


                    <!-- NAME -->
                    <div class="admin-create-set-field field-full">

                        <label asp-for="Name">
                            Nom de l'extension
                            <span>*</span>
                        </label>

                        <div class="admin-create-set-input-wrapper">

                            <i data-lucide="text"></i>

                            <input asp-for="Name"
                                   id="Name"
                                   placeholder="Ex : Première Génération"
                                   autocomplete="off" />

                        </div>

                        <span asp-validation-for="Name"
                              class="admin-create-set-validation">
                        </span>

                        <small>
                            Maximum 100 caractères.
                        </small>

                    </div>


                    <!-- CODE -->
                    <div class="admin-create-set-field">

                        <label asp-for="Code">
                            Code de l'extension
                            <span>*</span>
                        </label>

                        <div class="admin-create-set-input-wrapper">

                            <i data-lucide="hash"></i>

                            <input asp-for="Code"
                                   id="Code"
                                   placeholder="Ex : P01"
                                   maxlength="20"
                                   autocomplete="off" />

                        </div>

                        <span asp-validation-for="Code"
                              class="admin-create-set-validation">
                        </span>

                        <small>
                            Exemple : P01, P02, EX01...
                        </small>

                    </div>


                    <!-- RELEASE DATE -->
                    <div class="admin-create-set-field">

                        <label asp-for="ReleaseDate">
                            Date de sortie
                            <span>*</span>
                        </label>

                        <div class="admin-create-set-input-wrapper">

                            <i data-lucide="calendar-days"></i>

                            <input asp-for="ReleaseDate"
                                   id="ReleaseDate"
                                   type="date" />

                        </div>

                        <span asp-validation-for="ReleaseDate"
                              class="admin-create-set-validation">
                        </span>

                    </div>


                    <!-- PRICE -->
                    <div class="admin-create-set-field">

                        <label asp-for="BoosterPrice">
                            Prix du booster
                            <span>*</span>
                        </label>

                        <div class="admin-create-set-input-wrapper">

                            <i data-lucide="coins"></i>

                            <input asp-for="BoosterPrice"
                                   id="BoosterPrice"
                                   type="number"
                                   min="0"
                                   max="999999999"
                                   step="0.01"
                                   placeholder="Ex : 100" />

                        </div>

                        <span asp-validation-for="BoosterPrice"
                              class="admin-create-set-validation">
                        </span>

                        <small>
                            Prix dans la monnaie virtuelle du jeu.
                        </small>

                    </div>


                    <!-- STATUS -->
                    <div class="admin-create-set-field">

                        <label>
                            Statut
                        </label>

                        <label for="IsActive" class="admin-create-set-switch">

                            <input asp-for="IsActive"
                                   id="IsActive"
                                   type="checkbox" role="switch" />

                            <span class="admin-create-set-switch-track">
                                <span></span>
                            </span>

                            <span class="admin-create-set-switch-label">
                                Extension active
                            </span>

                        </label>

                        <small>
                            Une extension inactive ne sera pas proposée
                            dans la boutique.
                        </small>

                    </div>


                </div>

            </section>


            <!-- SECTION 02 -->
            <section class="admin-create-set-section">

                <div class="admin-create-set-section-heading">

                    <div class="admin-create-set-section-number">
                        02
                    </div>

                    <div>
                        <span>VISUEL</span>

                        <h2>
                            Identité du booster
                        </h2>

                        <p>
                            Ajoutez l'image qui représentera le booster
                            dans la boutique.
                        </p>
                    </div>

                </div>


                <div class="admin-create-set-fields">

                    <div class="admin-create-set-field field-full">

                        <label for="boosterImageFile">Image du booster <span>*</span></label>
                        <div class="card-image-uploader" data-card-image-uploader>
                            <input asp-for="BoosterImageUrl" type="hidden" class="card-image-path" />
                            <input type="file" id="boosterImageFile" class="card-image-file" accept="image/png,image/jpeg,image/webp" tabindex="-1" />
                            <div class="card-image-preview @(string.IsNullOrWhiteSpace(Model.BoosterImageUrl) ? "is-empty" : "")">
                                <img src="@Model.BoosterImageUrl" class="card-image-preview-img" alt="Aperçu du booster" hidden="@string.IsNullOrWhiteSpace(Model.BoosterImageUrl)" />
                                <div class="card-image-preview-empty"><i data-lucide="image"></i><span>Aucune image</span></div>
                            </div>
                            <button type="button" class="card-image-dropzone" data-card-image-dropzone>
                                <span class="card-image-dropzone-icon"><i data-lucide="upload-cloud"></i></span>
                                <span class="card-image-dropzone-copy"><strong>Déposez l’image du booster</strong><small>Cliquez, glissez-déposez ou collez une image</small></span>
                                <span class="card-image-dropzone-format">PNG · JPG · WEBP · 8 Mo max.</span>
                            </button>
                            <div class="card-image-upload-status" data-card-image-status role="status" aria-live="polite"></div>
                        </div>
                        <span asp-validation-for="BoosterImageUrl" class="admin-create-set-validation"></span>
                        <small>L’image est enregistrée dans le stockage interne du site.</small>
                    </div>

                </div>

            </section>


            <!-- ACTIONS -->
            <div class="admin-create-set-actions">

                <a asp-controller="Admin"
                   asp-action="CardSets"
                   class="admin-create-set-cancel">

                    <i data-lucide="arrow-left"></i>
                    <span>Annuler</span>

                </a>

                <button type="submit"
                        class="admin-create-set-submit">

                    <i data-lucide="@(isEditing ? "save" : "plus")"></i>

                    <span>
                        @(isEditing ? "Enregistrer les modifications" : "Créer l’extension")
                    </span>

                    <i data-lucide="arrow-up-right"></i>

                </button>

            </div>

        </div>


        <!-- ==========================================
             RIGHT : PREVIEW
             ========================================== -->

        <aside class="admin-create-set-preview">

            <div class="admin-create-set-preview-panel">

                <!-- PREVIEW HEADER -->
                <div class="admin-create-set-preview-header">

                    <div>

                        <span>
                            APERÇU EN DIRECT
                        </span>

                        <h2>
                            Booster
                        </h2>

                    </div>

                    <div class="admin-create-set-live">

                        <span></span>
                        LIVE

                    </div>

                </div>


                <!-- BOOSTER -->
                <div class="admin-create-set-booster-preview">

                    <div class="admin-create-set-booster-frame">

                        <div class="admin-create-set-booster-glow"></div>

                        <img id="boosterPreview"
                             src=""
                             alt="Aperçu du booster"
                             class="hidden" />

                        <div id="boosterPlaceholder"
                             class="admin-create-set-booster-placeholder">

                            <i data-lucide="image"></i>

                            <span>
                                L'image du booster
                                apparaîtra ici
                            </span>

                        </div>

                        <div class="admin-create-set-booster-shine"></div>

                    </div>

                </div>


                <!-- PREVIEW INFO -->
                <div class="admin-create-set-preview-info">

                    <div class="admin-create-set-preview-name">

                        <span>
                            EXTENSION
                        </span>

                        <strong id="previewName">
                            Nouvelle Extension
                        </strong>

                    </div>


                    <div class="admin-create-set-preview-grid">

                        <div class="admin-create-set-preview-stat">

                            <span>
                                CODE
                            </span>

                            <strong id="previewCode">
                                ---
                            </strong>

                        </div>

                        <div class="admin-create-set-preview-stat">

                            <span>
                                PRIX
                            </span>

                            <strong id="previewPrice">
                                0
                            </strong>

                            <small>
                                crédits
                            </small>

                        </div>

                    </div>


                    <div class="admin-create-set-preview-stat admin-create-set-preview-date">

                        <span>
                            DATE DE SORTIE
                        </span>

                        <strong id="previewDate">
                            —
                        </strong>

                    </div>


                    <div class="admin-create-set-preview-status">

                        <span>
                            Disponibilité
                        </span>

                        <span id="previewStatusBadge"
                              class="admin-create-set-status inactive">
                            INACTIVE
                        </span>

                    </div>

                </div>


                <!-- PREVIEW FOOTER -->
                <div class="admin-create-set-preview-footer">

                    <i data-lucide="info"></i>

                    <span>
                        L'aperçu se met automatiquement à jour
                        pendant la saisie.
                    </span>

                </div>

            </div>

        </aside>

    </form>

</div>


</div>

@section Scripts {


<partial name="_ValidationScriptsPartial" />
<script src="~/js/card-image-upload.js" asp-append-version="true"></script>

<script>

    document.addEventListener('DOMContentLoaded', function () {

        const nameInput =
            document.getElementById('Name');

        const codeInput =
            document.getElementById('Code');

        const priceInput =
            document.getElementById('BoosterPrice');

        const dateInput =
            document.getElementById('ReleaseDate');

        const imageInput =
            document.getElementById('BoosterImageUrl');

        const activeInput =
            document.getElementById('IsActive');


        const previewName =
            document.getElementById('previewName');

        const previewCode =
            document.getElementById('previewCode');

        const previewPrice =
            document.getElementById('previewPrice');

        const previewDate =
            document.getElementById('previewDate');

        const previewImage =
            document.getElementById('boosterPreview');

        const placeholder =
            document.getElementById('boosterPlaceholder');

        const statusBadge =
            document.getElementById('previewStatusBadge');


        function updatePreview() {

            /*
             * NOM
             */
            const name =
                nameInput.value.trim();

            previewName.textContent =
                name || 'Nouvelle Extension';


            /*
             * CODE
             */
            const code =
                codeInput.value.trim().toUpperCase();

            previewCode.textContent =
                code || '---';


            /*
             * PRIX
             */
            const price =
                parseFloat(priceInput.value);

            if (!Number.isNaN(price)) {

                previewPrice.textContent =
                    price.toLocaleString('fr-FR', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });

            } else {

                previewPrice.textContent = '0.00';

            }


            /*
             * DATE
             */
            if (dateInput.value) {

                const date =
                    new Date(
                        dateInput.value + 'T00:00:00'
                    );

                previewDate.textContent =
                    date.toLocaleDateString(
                        'fr-FR',
                        {
                            day: '2-digit',
                            month: '2-digit',
                            year: 'numeric'
                        }
                    );

            } else {

                previewDate.textContent = '—';

            }


            /*
             * IMAGE
             */
            const imageUrl =
                imageInput.value.trim();

            if (imageUrl) {

                previewImage.src = imageUrl;

                previewImage.classList.remove('hidden');
                placeholder.classList.add('hidden');

            } else {

                previewImage.removeAttribute('src');

                previewImage.classList.add('hidden');
                placeholder.classList.remove('hidden');

            }


            /*
             * STATUT
             */
            if (activeInput.checked) {

                statusBadge.textContent =
                    'ACTIVE';

                statusBadge.className =
                    'admin-create-set-status active';

            } else {

                statusBadge.textContent =
                    'INACTIVE';

                statusBadge.className =
                    'admin-create-set-status inactive';

            }

        }


        /*
         * EVENTS
         */

        nameInput.addEventListener(
            'input',
            updatePreview
        );

        codeInput.addEventListener(
            'input',
            function () {

                this.value =
                    this.value.toUpperCase();

                updatePreview();

            }
        );

        priceInput.addEventListener(
            'input',
            updatePreview
        );

        dateInput.addEventListener(
            'change',
            updatePreview
        );

        imageInput.addEventListener(
            'input',
            updatePreview
        );

        imageInput.addEventListener(
            'change',
            updatePreview
        );

        activeInput.addEventListener(
            'change',
            updatePreview
        );


        /*
         * IMAGE ERROR
         */

        previewImage.addEventListener(
            'error',
            function () {

                previewImage.classList.add('hidden');
                placeholder.classList.remove('hidden');

            }
        );


        /*
         * INITIAL PREVIEW
         */

        updatePreview();


        /*
         * LUCIDE
         */

        if (window.lucide) {
            lucide.createIcons();
        }

    });

</script>


}
