@model IReadOnlyList<web_tcg.Data.Entities.PoliticalParty>
@using System.ComponentModel.DataAnnotations
@{
    ViewData["Title"] = "Partis politiques";
    Layout = "_Layout";
}
<link rel="stylesheet" href="~/css/admin-political-parties.css" asp-append-version="true" />
<div class="party-admin">
    <header><div><span class="party-eyebrow">ADMINISTRATION</span><h1>Partis politiques</h1><p>@Model.Count parti(s) enregistré(s)</p></div><a asp-action="Create" class="party-button party-primary">+ Nouveau parti</a></header>
    @if (TempData["Error"] is string error) { <div class="party-error" role="alert">@error</div> }
    @if (TempData["Success"] is string success) { <p role="status">@success</p> }
    @if (Model.Count == 0) { <div class="party-empty">Aucun parti politique. Créez le premier pour l’associer à vos cartes.</div> }
    <div class="party-list">
        @foreach (var party in Model)
        {
            var orientation = typeof(web_tcg.Data.Enums.PoliticalOrientation).GetField(party.Orientation.ToString())?.GetCustomAttributes(typeof(DisplayAttribute), false).OfType<DisplayAttribute>().FirstOrDefault()?.Name ?? party.Orientation.ToString();
            <article class="party-row">
                <div class="party-logo"><img src="@party.ImageUrl" alt="Logo de @party.Name" loading="lazy" /></div>
                <div class="party-detail"><h2>@party.Name</h2><p>@party.Country.Name · <span>@orientation</span></p></div>
                <div class="party-actions"><a asp-action="Create" asp-route-id="@party.Id" class="party-button">Modifier</a>
                    <form asp-action="Delete" asp-route-id="@party.Id" method="post"><button type="submit" class="party-button party-delete">Supprimer</button></form>
                </div>
            </article>
        }
    </div>
</div>
