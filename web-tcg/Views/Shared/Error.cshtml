@model web_tcg.Models.ErrorViewModel
@{
    Layout = null;
    var missing = Model.StatusCode == 404;
    var serverError = Model.StatusCode >= 500;
    var title = missing ? "Cette page s’est échappée du deck" : serverError ? "La partie rencontre un imprévu" : "Cette action est indisponible";
    var description = missing ? "La page recherchée n’existe pas ou a été déplacée. Revenez à l’accueil pour continuer votre aventure."
        : serverError ? "Une erreur est survenue. Réessayez dans quelques instants ; votre collection vous attend."
        : "Nous ne pouvons pas répondre à cette demande. Vous pouvez revenir à l’accueil.";
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>@Model.StatusCode — Worlds TCG</title>
    <link rel="stylesheet" href="~/css/error.css" asp-append-version="true" />
</head>
<body>
    <main class="error-page">
        <a class="brand" href="/">WORLDS <span>TCG</span></a>
        <div class="error-cards" aria-hidden="true"><span></span><span></span><span></span></div>
        <p class="error-code">@Model.StatusCode</p>
        <h1>@title</h1>
        <p class="description">@description</p>
        <div class="actions">
            <a class="button primary" href="/">Revenir à l’accueil <span aria-hidden="true">→</span></a>
            @if (serverError)
            {
                <button class="button secondary" type="button" id="retry">Réessayer</button>
            }
        </div>
        @if (serverError && Model.ShowRequestId)
        {
            <p class="reference">Référence de l’erreur : <code>@Model.RequestId</code></p>
        }
        <p class="footer">Votre prochaine partie vous attend.</p>
    </main>
    <script src="~/js/error.js" asp-append-version="true" defer></script>
</body>
</html>
