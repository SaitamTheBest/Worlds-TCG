@model web_tcg.Models.Profile.UserMenuViewModel

<div class="tcg-user-menu"
     id="tcgUserMenu">

    <button type="button"
            class="tcg-user-profile"
            id="tcgUserMenuTrigger"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="tcgUserDropdown">

        <div class="tcg-user-avatar">
            @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
            {
                <img src="@Model.AvatarUrl"
                     alt="@Model.Username" />
            }
            else if (!string.IsNullOrWhiteSpace(Model.Username))
            {
                @Model.Username[..1].ToUpperInvariant()
            }
            else
            {
                <i data-lucide="user"></i>
            }
        </div>

        <div class="tcg-user-info">
            <strong>@Model.Username</strong>

            @if (Model.IsAdmin)
            {
                <span class="tcg-user-role admin">
                    ADMINISTRATEUR
                </span>
            }
            else
            {
                <span class="tcg-user-role">
                    COLLECTIONNEUR
                </span>
            }
        </div>

        <i data-lucide="chevron-down"
           class="tcg-user-chevron"></i>
    </button>

    <div class="tcg-user-dropdown"
         id="tcgUserDropdown"
         role="menu"
         aria-hidden="true">

        <div class="tcg-user-dropdown-header">
            <div class="tcg-user-dropdown-avatar">
                @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
                {
                    <img src="@Model.AvatarUrl"
                         alt="@Model.Username" />
                }
                else
                {
                    @(Model.Username.Length > 0
                        ? Model.Username[..1].ToUpperInvariant()
                        : "?")
                }
            </div>

            <div>
                <strong>@Model.Username</strong>

                <span>
                    @(Model.IsAdmin
                        ? "Administrateur"
                        : "Collectionneur")
                </span>
            </div>
        </div>

        <div class="tcg-user-dropdown-separator"></div>

        <a asp-controller="Profile"
           asp-action="Index"
           class="tcg-user-dropdown-item">

            <i data-lucide="user-round"></i>

            <span>
                <strong>Voir le profil</strong>
                <small>Compte et personnalisation</small>
            </span>
        </a>

        <div class="tcg-user-dropdown-separator"></div>

        <form method="post"
              asp-controller="Auth"
              asp-action="Logout"
              class="tcg-user-dropdown-form">

            <button type="submit"
                    class="tcg-user-dropdown-item tcg-user-dropdown-logout">

                <i data-lucide="log-out"></i>

                <span>
                    <strong>Déconnexion</strong>
                </span>
            </button>
        </form>
    </div>
</div>