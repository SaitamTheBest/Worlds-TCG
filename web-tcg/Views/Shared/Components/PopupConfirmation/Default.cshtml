<dialog id="popupConfirmation" class="popup-confirmation" aria-labelledby="popupConfirmationTitle" aria-describedby="popupConfirmationMessage">
    <div class="popup-confirmation-panel">
        <div class="popup-confirmation-icon" aria-hidden="true">!</div>
        <div class="popup-confirmation-content">
            <span class="popup-confirmation-label">CONFIRMATION</span>
            <h2 id="popupConfirmationTitle">Confirmer l’action</h2>
            <p id="popupConfirmationMessage"></p>
        </div>
        <div class="popup-confirmation-actions">
            <button type="button" id="popupConfirmationCancel" class="popup-confirmation-cancel" autofocus>Annuler</button>
            <button type="button" id="popupConfirmationAccept" class="popup-confirmation-accept">Confirmer</button>
        </div>
    </div>
</dialog>
