@model web_tcg.Models.Card.CardViewModel
@{ var engravingId = "secret-engraving-" + Guid.NewGuid().ToString("N"); }
<div class="tcg-card tcg-card-fullart tcg-card-secret" aria-label="@Model.Name — SECRET Gold">
    <svg class="tcg-secret-filter" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
        <defs>
            <filter id="@engravingId" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
                <feColorMatrix type="saturate" values="0" result="monochrome" />
                <feConvolveMatrix in="monochrome" order="3" kernelMatrix="-1 -1 0 -1 1 1 0 1 1" divisor="1" bias="0.5" preserveAlpha="true" result="relief" />
                <feBlend in="monochrome" in2="relief" mode="soft-light" result="engraved" />
                <feComponentTransfer in="engraved">
                    <feFuncR type="table" tableValues="0.12 0.36 0.66 0.9 1" />
                    <feFuncG type="table" tableValues="0.055 0.19 0.39 0.67 0.91" />
                    <feFuncB type="table" tableValues="0.01 0.035 0.085 0.25 0.57" />
                </feComponentTransfer>
            </filter>
        </defs>
    </svg>
    <div class="tcg-card-art">
        <img src="@Model.ImageUrl" alt="@Model.Name" loading="lazy" style="filter:url(#@engravingId)" />
    </div>
    <div class="tcg-secret-gold-overlay" aria-hidden="true"></div>
    <div class="tcg-secret-foil" aria-hidden="true"></div>
    <div class="tcg-card-identity">
        <div class="tcg-card-name">@Model.Name</div>
    </div>
    <div class="tcg-card-bottom-meta">
        <span class="tcg-card-number">@(string.IsNullOrWhiteSpace(Model.CardSetCode) ? "0" : Model.CardSetCode + "-0")</span>
    </div>
</div>
