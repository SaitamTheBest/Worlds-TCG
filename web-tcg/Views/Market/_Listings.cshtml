@using web_tcg.Data.Entities
@model web_tcg.Models.Market.MarketIndexViewModel
@{
    var action=Model.Mode == "sales" ? "MySales" : Model.Mode == "history" ? "History" : Model.Mode == "purchases" ? "Purchases" : "Index";
}
<div class="market-summary"><span>@Model.Total @(Model.Mode == "purchases" ? "achat(s)" : "vente(s)")</span><strong>Mes ventes en cours : @Model.ActiveSales / 10</strong></div>
@if (Model.Listings.Count == 0)
{
    <div class="market-empty"><i data-lucide="gavel"></i><h2>@(Model.Mode == "purchases" ? "Aucun achat pour le moment" : "Aucune vente ici pour le moment")</h2><p>@(Model.Mode == "purchases" ? "Les cartes remportées aux enchères apparaîtront ici après la clôture de la vente." : Model.Mode == "history" ? "Vos ventes terminées et annulées apparaîtront ici." : "Mettez une carte en vente ou revenez découvrir les prochaines enchères.")</p></div>
}
else
{
    <div class="market-grid">
        @foreach (var item in Model.Listings)
        {
            <article class="market-listing">
                <a asp-action="Auction" asp-route-id="@item.Auction.Id" class="market-card-link" aria-label="Consulter la vente de @item.Card.Name">
                    @await Component.InvokeAsync("Card",new {model=item.Card})
                </a>
                <div class="market-listing-meta">
                    <span class="market-status">@(Model.Mode == "purchases" ? "Achetée" : item.Status)</span>
                    <p>Vendeur : <strong>@item.Auction.Seller.UserName</strong></p>
                    <div class="market-listing-price">@await Html.PartialAsync("~/Views/Shared/_MarketCurrency.cshtml", new web_tcg.Models.Balance.MarketCurrencyViewModel { Amount=item.Auction.CurrentPrice })</div>
                    <p>@item.BidCount enchère(s) @(item.IsHighestBidder ? item.Auction.Status == AuctionStatus.Sold ? "· Vous avez remporté cette carte" : "· Vous êtes en tête" : "")</p>
                    @if (item.Auction.Status == AuctionStatus.Active)
                    {
                        <p>Fin dans <strong data-market-end="@item.Auction.EndsAt.ToString("O")">—</strong></p>
                    }
                    else
                    {
                        <p>Clôturée le @item.Auction.ClosedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                        @if (item.Auction.Status == AuctionStatus.Sold) { <p>Acheteur : @item.Auction.HighestBidder?.UserName</p> }
                    }
                    <a class="market-button secondary" asp-action="Auction" asp-route-id="@item.Auction.Id">@(item.Auction.Status == AuctionStatus.Active ? "Voir l’enchère" : "Détail de la vente")</a>
                </div>
            </article>
        }
    </div>
}
<nav class="market-pagination" aria-label="Pages des ventes" data-server-utc="@DateTime.UtcNow.ToString("O")">
    @if (Model.Page>1) { <a asp-action="@action" asp-route-page="@(Model.Page-1)" asp-route-search="@Model.Search">← Précédent</a> }
    <span>Page @Model.Page</span>
    @if (Model.Page*20<Model.Total) { <a asp-action="@action" asp-route-page="@(Model.Page+1)" asp-route-search="@Model.Search">Suivant →</a> }
</nav>
