@model web_tcg.Models.ForgotPasswordViewModel
@{ Layout="~/Views/Auth/_RecoveryLayout.cshtml"; ViewData["Title"]="Mot de passe oublié"; }
<h1>Mot de passe oublié</h1>
@if (ViewBag.Confirmation != null) { <p class="notice" role="status">@ViewBag.Confirmation</p> }
else {
<p>Saisissez l’adresse email de votre compte pour recevoir un lien de réinitialisation.</p>
<form action="/Auth/ForgotPassword" method="post">
@Html.AntiForgeryToken()
<div asp-validation-summary="All" class="errors" role="alert"></div>
<label asp-for="Email">Adresse email</label><input asp-for="Email" type="email" autocomplete="email" required maxlength="254" />
<button type="submit">Envoyer le lien</button></form>
}
<a href="/Auth">Revenir à la connexion</a>
