@model web_tcg.Models.ResetPasswordViewModel
@{ Layout="~/Views/Auth/_RecoveryLayout.cshtml"; ViewData["Title"]="Nouveau mot de passe"; }
<h1>Choisir un nouveau mot de passe</h1>
@if (ViewBag.InvalidLink == true) { <p class="errors" role="alert">Ce lien est incomplet ou invalide.</p> }
else {
<form action="/Auth/ResetPassword" method="post">
@Html.AntiForgeryToken()
<input asp-for="UserId" type="hidden" /><input asp-for="Token" type="hidden" />
<div asp-validation-summary="All" class="errors" role="alert"></div>
<label asp-for="Password">Nouveau mot de passe</label><input asp-for="Password" autocomplete="new-password" required minlength="6" maxlength="128" />
<label asp-for="ConfirmPassword">Confirmer le mot de passe</label><input asp-for="ConfirmPassword" autocomplete="new-password" required minlength="6" maxlength="128" />
<button type="submit">Enregistrer mon mot de passe</button></form>
}
<a href="/Auth/ForgotPassword">Demander un nouveau lien</a>
