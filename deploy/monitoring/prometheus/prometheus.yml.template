global:
  scrape_interval: 30s
  scrape_timeout: 10s
  evaluation_interval: 30s
  external_labels: {site: worlds-tcg, environment: production}
rule_files: [/etc/prometheus/alerts.yml]
alerting:
  alertmanagers:
    - static_configs:
        - targets: ['alertmanager:9093']
scrape_configs:
  - job_name: application
    static_configs: [{targets: ['web-tcg:9091']}]
  - job_name: postgres
    static_configs: [{targets: ['postgres-exporter:9187']}]
  - job_name: host
    static_configs: [{targets: ['node-exporter:9100']}]
  - job_name: containers
    sample_limit: 20000
    static_configs: [{targets: ['cadvisor:8080']}]
  - job_name: prometheus
    static_configs: [{targets: ['localhost:9090']}]
  - job_name: alertmanager
    static_configs: [{targets: ['alertmanager:9093']}]
  - job_name: loki
    static_configs: [{targets: ['loki:3100']}]
  - job_name: https
    metrics_path: /probe
    params: {module: [https]}
    static_configs:
      - targets: ['https://APP_DOMAIN_PLACEHOLDER/health', 'https://GRAFANA_DOMAIN_PLACEHOLDER/api/health']
    relabel_configs:
      - {source_labels: [__address__], target_label: __param_target}
      - {source_labels: [__param_target], target_label: instance}
      - {target_label: __address__, replacement: 'blackbox:9115'}
